# Copy to release.env (never commit it) and fill in. Used by build_release.ps1.
# The https:// address of your production backend (no trailing slash).
BASE_URL=https://api.your-domain.com
# Supabase -> Project Settings -> API (the anon/public key; safe to ship in the app).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
