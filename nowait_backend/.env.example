# Supabase (Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key   # SECRET: backend only, never in the app or git
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Google Maps/Places (server-side proxy for /maps/*) — restrict this key in Google Cloud
GOOGLE_MAP_KEY=your-google-maps-key

# Razorpay — use rzp_test_ keys while testing; swap for live keys only at launch
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret      # SECRET: backend only

# Admin panel (/nowaitt_778admin) — login is disabled while ADMIN_PASSWORD is empty
ADMIN_USERNAME=778Admin
ADMIN_PASSWORD=

# Browsers allowed to call the API. Leave empty for the mobile app (CORS is browser-only).
# ALLOWED_ORIGINS=*   # only for running the Flutter web build locally
# "production" hides /docs (Render sets RENDER=true, which counts as production)
# ENVIRONMENT=production

# Free-trial record: keyed hash of owners' email / mobile number so a deleted account cannot claim a second free month.
# Use a long random value (python -c "import secrets; print(secrets.token_urlsafe(48))"), use the SAME value
# everywhere the app runs (local .env and Render), and NEVER change it afterwards.
TRIAL_HASH_KEY=
