# Copy to .env (local) or add as environment variables on your server. See PRODUCTION.md.

# ── Supabase (Project Settings > API) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key   # SECRET: the service_role key, backend only, never in the app or git
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ── Server ──
# "production" hides /docs. Render sets RENDER=true, which counts as production; anywhere else set this.
ENVIRONMENT=production
# Browsers allowed to call the API. Leave empty for the mobile app (CORS is browser-only).
ALLOWED_ORIGINS=
# Deep link in password-reset emails; must match AndroidManifest + Supabase redirect allow-list.
PASSWORD_RESET_REDIRECT_URL=io.nowait.app://auth-callback

# ── Admin panel (/nowaitt_778admin) — login is disabled while ADMIN_PASSWORD is empty ──
ADMIN_USERNAME=778Admin
ADMIN_PASSWORD=                               # SECRET: long random password

# ── Google Maps/Places (server-side proxy for /maps/*) — restrict this key in Google Cloud ──
GOOGLE_MAP_KEY=your-google-maps-key

# ── Razorpay ──
# Test: rzp_test_ keys and RAZORPAY_ALLOW_LIVE=false. Launch: rzp_live_ keys and RAZORPAY_ALLOW_LIVE=true
# (the backend refuses live keys unless this is true, so real money cannot move by accident).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=                          # SECRET: backend only
RAZORPAY_ALLOW_LIVE=false
# The secret you type in Razorpay dashboard -> Settings -> Webhooks (NOT the API secret). Test and
# Live mode have separate webhooks. URL: https://<your-server>/payments/webhook
# Events: payment.captured, order.paid, payment.failed
RAZORPAY_WEBHOOK_SECRET=                      # SECRET

# ── Free trial record ── long random value, the SAME everywhere, NEVER change it once owners use trials.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
TRIAL_HASH_KEY=                               # SECRET

# ── Public policy pages (/legal/...) required by Google Play and Razorpay ──
LEGAL_BUSINESS_NAME=NOWAITT
SUPPORT_EMAIL=nowaitt778@gmail.com
SUPPORT_PHONE=
LEGAL_ADDRESS=                                # your registered business address
LEGAL_JURISDICTION=                           # e.g. Akola, Maharashtra (defaults to India)

# ── Cloudflare (PRODUCTION.md section 4b) ── leave empty until Cloudflare is in front of the server.
# Same value as the X-Origin-Secret header in the Cloudflare Transform Rule. When set, requests that
# skip Cloudflare are refused (403) and rate limits use Cloudflare's real visitor IP.
CLOUDFLARE_ORIGIN_SECRET=                     # SECRET
